<ul class="form-list israelguido-mercadopago-form" id="payment_form_<?= $this->escapeHtml($_code) ?>" style="display:none;">
    <li>
        <p><?= $this->__('Bank slip') ?></p>
        <p><?= $this->__('The boleto will be shown after you place the order.') ?></p>
